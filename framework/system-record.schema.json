{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/patkusch/remit/framework/system-record.schema.json",
  "title": "Remit AI System Record",
  "description": "The single shared artefact every Remit skill reads from and writes to. One record per AI system or agent. Governance falls apart when each framework assessment keeps its own private notion of what the system is; this schema is the fix.",
  "type": "object",
  "required": [
    "id",
    "name",
    "status",
    "owner",
    "purpose",
    "lifecycle_stage"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable internal identifier. Never reused, never renumbered.",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "name": {
      "type": "string",
      "description": "Human-readable name as used inside the organisation."
    },
    "version": {
      "type": "string",
      "description": "Version of the system this record describes."
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "in-development",
        "in-testing",
        "live",
        "suspended",
        "retired"
      ]
    },
    "lifecycle_stage": {
      "type": "string",
      "description": "Where in the lifecycle. Drives which obligations are already live versus anticipated.",
      "enum": [
        "concept",
        "design",
        "build",
        "validation",
        "deployment",
        "operation",
        "decommission"
      ]
    },
    "last_reviewed": {
      "$ref": "#/$defs/dateOrUnknown"
    },
    "next_review_due": {
      "$ref": "#/$defs/dateOrUnknown"
    },
    "owner": {
      "type": "object",
      "description": "Accountability must resolve to a named person. Teams cannot be held accountable; people can.",
      "required": [
        "accountable_person",
        "business_unit"
      ],
      "additionalProperties": false,
      "properties": {
        "accountable_person": {
          "type": "string"
        },
        "accountable_role": {
          "type": "string"
        },
        "business_unit": {
          "type": "string"
        },
        "technical_contact": {
          "type": "string"
        }
      }
    },
    "purpose": {
      "type": "object",
      "required": [
        "intended_use"
      ],
      "additionalProperties": false,
      "properties": {
        "intended_use": {
          "type": "string",
          "description": "What it is for, in plain language a non-specialist can check."
        },
        "out_of_scope_uses": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Explicitly excluded uses. Populating this is one of the highest-value fields in the record: it converts assumptions into commitments and is the basis of most misuse findings."
        },
        "affected_persons": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Who is affected by outputs or actions, including people who are not users."
        },
        "decision_consequence": {
          "type": "string",
          "description": "What happens to an affected person as a result. The key input to EU AI Act Annex III screening.",
          "enum": [
            "none",
            "informational",
            "influences-human-decision",
            "determines-outcome"
          ]
        }
      }
    },
    "agentic": {
      "type": "object",
      "description": "Present when the system takes actions rather than only producing outputs. See framework/autonomy-tiers.md.",
      "required": [
        "autonomy_tier",
        "blast_radius"
      ],
      "additionalProperties": false,
      "properties": {
        "autonomy_tier": {
          "type": "string",
          "enum": [
            "A0",
            "A1",
            "A2",
            "A3",
            "A4"
          ],
          "description": "Declared tier. Record what is actually run, not what was designed."
        },
        "observed_tier": {
          "type": "string",
          "enum": [
            "A0",
            "A1",
            "A2",
            "A3",
            "A4"
          ],
          "description": "Tier evidenced by operational data (e.g. measured approval behaviour). A gap against autonomy_tier is a finding in its own right."
        },
        "blast_radius": {
          "type": "string",
          "enum": [
            "B0",
            "B1",
            "B2",
            "B3"
          ]
        },
        "oversight_level": {
          "type": "string",
          "enum": [
            "minimal",
            "standard",
            "enhanced",
            "constrained",
            "prohibited"
          ],
          "description": "Derived from the governance grid. Do not set by hand without recording a justification in exceptions."
        },
        "tools": {
          "type": "array",
          "description": "The governed artefact. Blast radius follows from the tools held, not from typical behaviour.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "blast_radius"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "blast_radius": {
                "type": "string",
                "enum": [
                  "B0",
                  "B1",
                  "B2",
                  "B3"
                ]
              },
              "reversible": {
                "$ref": "#/$defs/boolOrUnknown"
              },
              "justification": {
                "type": "string",
                "description": "Why the agent needs this. Absence of a justification is itself a finding."
              },
              "credential_scope": {
                "type": "string"
              },
              "requires_approval": {
                "$ref": "#/$defs/boolOrUnknown"
              }
            }
          }
        },
        "halt_mechanism": {
          "type": "object",
          "description": "Required from oversight_level 'enhanced' upward. An untested halt is not a halt.",
          "additionalProperties": false,
          "properties": {
            "exists": {
              "$ref": "#/$defs/boolOrUnknown"
            },
            "how": {
              "type": "string"
            },
            "last_tested": {
              "$ref": "#/$defs/testDate"
            },
            "time_to_halt_seconds": {
              "type": "number"
            }
          }
        },
        "memory": {
          "type": "object",
          "description": "Persistence is what turns a session-scoped failure into a durable one. See diagnostic-manual.md M1.",
          "additionalProperties": false,
          "properties": {
            "persistent": {
              "$ref": "#/$defs/boolOrUnknown"
            },
            "scope": {
              "type": "string",
              "enum": [
                "none",
                "session",
                "user",
                "tenant",
                "global"
              ]
            },
            "provenance_recorded": {
              "$ref": "#/$defs/boolOrUnknown"
            },
            "review_cadence": {
              "type": "string"
            }
          }
        },
        "reads_untrusted_content": {
          "$ref": "#/$defs/boolOrUnknown",
          "description": "True if the agent processes any content a third party can influence. If true, injection testing is not optional."
        },
        "delegates_to_subagents": {
          "$ref": "#/$defs/boolOrUnknown",
          "description": ""
        },
        "tier_history": {
          "type": "array",
          "description": "Autonomy creep is gradual and each step looks reasonable. The history is how you see the trajectory.",
          "items": {
            "type": "object",
            "required": [
              "date",
              "autonomy_tier",
              "blast_radius",
              "reason"
            ],
            "additionalProperties": false,
            "properties": {
              "date": {
                "type": "string",
                "format": "date"
              },
              "autonomy_tier": {
                "type": "string",
                "enum": [
                  "A0",
                  "A1",
                  "A2",
                  "A3",
                  "A4"
                ]
              },
              "blast_radius": {
                "type": "string",
                "enum": [
                  "B0",
                  "B1",
                  "B2",
                  "B3"
                ]
              },
              "reason": {
                "type": "string"
              },
              "approved_by": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "personal_data": {
          "$ref": "#/$defs/boolOrUnknown"
        },
        "special_category_data": {
          "$ref": "#/$defs/boolOrUnknown"
        },
        "data_sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "training_data_provenance": {
          "type": "string"
        },
        "retention": {
          "type": "string"
        }
      }
    },
    "supply_chain": {
      "type": "object",
      "description": "Most organisations are deployers, not providers. Role determines which obligations attach.",
      "additionalProperties": false,
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "provider",
            "deployer",
            "importer",
            "distributor",
            "product-manufacturer"
          ],
          "description": "EU AI Act role. Note Art. 25: substantial modification or own-branding can convert a deployer into a provider."
        },
        "base_model": {
          "type": "string"
        },
        "base_model_supplier": {
          "type": "string"
        },
        "third_party_components": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "critical_or_important_function": {
          "$ref": "#/$defs/boolOrUnknown",
          "description": "DORA determination. Drives ICT third-party register and resilience-testing obligations."
        }
      }
    },
    "assessments": {
      "type": "array",
      "description": "Written by the framework skills. Each entry is one assessment against one framework at one point in time; entries are appended, never edited, so the history stands up to audit.",
      "items": {
        "type": "object",
        "required": [
          "framework",
          "date",
          "outcome"
        ],
        "additionalProperties": false,
        "properties": {
          "framework": {
            "type": "string",
            "enum": [
              "eu-ai-act",
              "nist-ai-rmf",
              "iso-42001",
              "dora",
              "remit-autonomy",
              "other"
            ]
          },
          "framework_version": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "assessor": {
            "type": "string"
          },
          "outcome": {
            "type": "string",
            "description": "Headline conclusion, e.g. 'high-risk, Annex III 5(b)' or 'limited risk, Art. 50 transparency only'."
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "requires_legal_review": {
            "type": "boolean"
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "reference",
                "status"
              ],
              "additionalProperties": false,
              "properties": {
                "reference": {
                  "type": "string",
                  "description": "Control or article reference, e.g. 'Art. 14' or 'MANAGE 2.4'."
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "met",
                    "partial",
                    "not-met",
                    "not-applicable",
                    "unknown"
                  ]
                },
                "evidence": {
                  "type": "string"
                },
                "gap": {
                  "type": "string"
                },
                "owner": {
                  "type": "string"
                },
                "due": {
                  "type": "string",
                  "format": "date"
                }
              }
            }
          }
        }
      }
    },
    "incidents": {
      "type": "array",
      "description": "Written by ai-incident-triage. Classifications use the codes in framework/diagnostic-manual.md.",
      "items": {
        "type": "object",
        "required": [
          "date",
          "summary",
          "primary_classification"
        ],
        "additionalProperties": false,
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "summary": {
            "type": "string"
          },
          "primary_classification": {
            "type": "string",
            "pattern": "^[GPAMSR][0-9]+$",
            "description": "The failure whose absence would have prevented the harm."
          },
          "contributing_classifications": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[GPAMSR][0-9]+$"
            }
          },
          "severity": {
            "type": "string",
            "enum": [
              "mild",
              "moderate",
              "severe"
            ]
          },
          "blast_radius_realised": {
            "type": "string",
            "enum": [
              "B0",
              "B1",
              "B2",
              "B3"
            ]
          },
          "tier_mismatch": {
            "type": "boolean",
            "description": "True where the observed autonomy tier exceeded the declared one."
          },
          "external_reporting": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Reporting obligations engaged, e.g. 'EU AI Act Art. 73', 'DORA Art. 19', 'GDPR Art. 33'."
          },
          "remediation": {
            "type": "string"
          },
          "closed": {
            "type": "boolean"
          }
        }
      }
    },
    "exceptions": {
      "type": "array",
      "description": "Accepted deviations. An exception with no expiry is a policy change that nobody wrote down.",
      "items": {
        "type": "object",
        "required": [
          "description",
          "approved_by",
          "expires"
        ],
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "approved_by": {
            "type": "string"
          },
          "granted": {
            "type": "string",
            "format": "date"
          },
          "expires": {
            "type": "string",
            "format": "date"
          },
          "compensating_controls": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "$defs": {
    "dateOrUnknown": {
      "description": "An ISO date, or the literal \"unknown\". Intake must be able to record ignorance — a record that cannot say \"we don't know\" forces someone to invent an answer, which is the failure ai-system-intake exists to prevent.",
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "const": "unknown"
        }
      ]
    },
    "boolOrUnknown": {
      "description": "true, false, or the literal \"unknown\".",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "const": "unknown"
        }
      ]
    },
    "testDate": {
      "description": "An ISO date, \"never\" (genuinely never tested), or \"unknown\" (nobody could say). The distinction matters: \"never\" is a finding, \"unknown\" is a question.",
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "const": "never"
        },
        {
          "const": "unknown"
        }
      ]
    }
  }
}
